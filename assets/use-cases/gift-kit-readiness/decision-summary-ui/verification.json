      "sha256": "8c2ab133b932bdd59aaf14c249332e25c38b7bb7f41ab866bc827f66226827fc",
      "alt": "The concise Decision summary prefers the $300 internal complete correction, ready at minute 40, and compares all five supplied packages.",
      "caption": "The default report leads with the supported response and the decisive condition for each package. Complete evidence, work and requirements remain available separately."
    },
    "ampleSummary": {
      "image": "/assets/use-cases/gift-kit-readiness/decision-summary-ui/04-ample-summary-comparison.png",
      "width": 883,
      "height": 999,
      "sha256": "a091795f0df1ea37d290000c18d5e5056fd252c4fd609b4c59d3335691331db2",
      "alt": "With a full day available, the same cost-first workflow prefers the $300 internal complete correction at minute 40.",
      "caption": "Full day: the $300 complete correction fits and costs less than the confirmed external package."
    },
    "calculationEvidence": {
      "image": "/assets/use-cases/gift-kit-readiness/decision-summary-ui/05-evidence.png",
      "width": 883,
      "height": 482,
      "sha256": "233bb339e41e1f07ada15e0df96bb892a1b44a8ac0408a7ad7b38ac68ffde9e9",
      "alt": "The Supporting reports Evidence view identifies the printed-code and wrong-destination faults supported by the scoped observations.",
      "caption": "Evidence establishes what the complete correction must address. A successful old checkout does not verify the corrected kits."
    },
    "calculationPlanning": {
      "image": "/assets/use-cases/gift-kit-readiness/decision-summary-ui/06-complete-arrangements.png",
      "width": 883,
      "height": 1944,
      "sha256": "378451a512303d7b2aecfbcb63c99e9de2a19aba48974a68c5543ad5a9ab17bb",
      "alt": "The complete-arrangements supporting report retains costs, handoff timing and conditions for all five supplied correction packages.",
      "caption": "Inspect the complete package when the summary raises a question. Choosing an inspection target changes neither the recommendation nor the recorded case."
    },
    "calculationProcess": {
      "image": "/assets/use-cases/gift-kit-readiness/decision-summary-ui/07-decision-process.png",
      "width": 835,
      "height": 1766,
      "sha256": "30709e6dd259e03226a88855d40f88e96f02653faaffb48a3c0db6c38fb38344",
      "alt": "The gift-kit Decision process connects evidence, complete arrangements and remaining business actions, with the current case overlaid on its branches.",
      "caption": "The authored process explains what to do when records conflict, work does not fit or a supported correction is available. It describes possible responses, not completed work."
    },
    "calculationDependencies": {
      "image": "/assets/use-cases/gift-kit-readiness/decision-summary-ui/08-calculation-dependencies.png",
