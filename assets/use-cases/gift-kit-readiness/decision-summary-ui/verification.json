      "height": 1454,
      "sha256": "c1cc144ad9f9fdac99c2248b0940be173f3370577a62940e64b5eb7002f95840",
      "alt": "With thirty minutes remaining, the same cost-first workflow supports the confirmed $400 external correction, finishing at minute 1435.",
      "caption": "Thirty minutes left: internal work finishes too late; the confirmed external package preserves five minutes before the same cutoff."
    },
    "oldBookingSummary": {
      "image": "/assets/use-cases/gift-kit-readiness/decision-summary-ui/10-urgent-old-booking-summary.png",
      "width": 883,
      "height": 1454,
      "sha256": "05fe01dec77b817b358b9b4ca6f7f155ceb3bc511d45ff81509d59b3395ab520",
      "alt": "With the same urgent inputs but a booking for insert-2 instead of current insert-3, the Decision summary shows no supported complete correction.",
      "caption": "A quote for fast work cannot replace a current booking. The old insert revision blocks external work while internal work still misses the deadline."
    },
    "calculationPending": {
      "image": "/assets/use-cases/gift-kit-readiness/decision-summary-ui/11-unapplied-budget-edit.png",
