      "sha256": "796a42583cfd2e86cc391ae88d289dde039883859b8df0f46ace65ac70e8b3bf",
      "alt": "The uncommitted $200 budget edit is flagged while the report continues to describe the last recorded $600 case.",
      "caption": "Draft input is separate from the recorded basis. Apply or discard the edit before recalculating."
    },
    "calculationStale": {
      "image": "/assets/use-cases/gift-kit-readiness/decision-summary-ui/12-applied-budget-stale.png",
