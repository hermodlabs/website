      "sha256": "f5ed49b8cfcda9fee003d61a6611dfe299d1c1fc27dbad0c48182d7dcde9739b",
      "alt": "After the $200 limit is applied, the alternatives are marked stale and the earlier current correction proposal is withdrawn.",
      "caption": "Changed spending invalidates the planning basis. Recalculate reassesses the affected result; unchanged evidence remains current and the earlier planning finding remains historical."
    },
    "calculationBlocked": {
      "image": "/assets/use-cases/gift-kit-readiness/decision-summary-ui/13-budget-200-decision-summary.png",
